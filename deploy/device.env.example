DEVICE_ID=co2-pi-01

# scd41（実機）または mock
SENSOR=scd41
I2C_DEVICE=/dev/i2c-1
INTERVAL=5s

# エンドポイントは `aws iot describe-endpoint --endpoint-type iot:Data-ATS` で調べられる
MQTT_BROKER=ssl://xxxxxxxxxxxxxx-ats.iot.ap-northeast-1.amazonaws.com:8883
MQTT_CA_FILE=/etc/co2-monitor/certs/AmazonRootCA1.pem
MQTT_CERT_FILE=/etc/co2-monitor/certs/device.cert.pem
MQTT_KEY_FILE=/etc/co2-monitor/certs/device.private.key
